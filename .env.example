# DevInsights Environment Configuration

# Optional: GitHub Personal Access Token to raise rate limits from 60 to 5,000 req/hr
# Create one at: https://github.com/settings/tokens (classic token with public_repo or no extra scopes needed)
GITHUB_TOKEN=

# Database Connection (Default: SQLite for local development)
# For production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/devinsights
DATABASE_URL=sqlite+aiosqlite:///./devinsights.db

# Cache TTL in seconds (Default: 900 seconds = 15 minutes)
CACHE_TTL_SECONDS=900

# Environment Mode (development / production)
ENVIRONMENT=development

# Frontend Dev Server Port
PORT=5173
